rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    // Legacy text: straight under users/{uid}
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.contentType.matches('image/.*')
                   && fileName.matches('profile(_[0-9]+)?\\.jpg');
    }
    
    // New structure: users/{uid}/profile_images/
    match /users/{uid}/profile_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.contentType.matches('image/.*')
                   && fileName.matches('profile(_[0-9]+)?\\.jpg');
    }

    // New structure: users/{uid}/college-id/
    match /users/{uid}/college-id/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.contentType.matches('image/.*');
    }
    // Voice notes are stored under the sender's uid; the recipient plays them via the
    // download URL saved in the (participant-only) chat message.
    match /chat-audio/{senderUid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == senderUid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == senderUid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }
    match /payments/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}