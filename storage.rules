rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same admin check as firestore.rules: server-set claim + fresh Google sign-in
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get('admin', false) == true
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.time.toMillis() < (request.auth.token.auth_time + 12 * 3600) * 1000
        // Both login steps (admin password, then Google) done for THIS sign-in
        && firestore.exists(/databases/(default)/documents/adminSessions/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/adminSessions/$(request.auth.uid)).data.authTime == request.auth.token.auth_time
        && firestore.get(/databases/(default)/documents/adminSessions/$(request.auth.uid)).data.expiresAtMs > request.time.toMillis();
    }

    // Legacy text: straight under users/{uid}
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && fileName.matches('profile(_[0-9]+)?\\.jpg');
    }
    
    // New structure: users/{uid}/profile_images/
    match /users/{uid}/profile_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && fileName.matches('profile(_[0-9]+)?\\.jpg');
    }

    // New structure: users/{uid}/college-id/
    match /users/{uid}/college-id/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Voice notes are stored under the sender's uid; the recipient plays them via the
    // download URL saved in the (participant-only) chat message.
    match /chat-audio/{senderUid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == senderUid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == senderUid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
    }
    match /payments/{uid}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Proof screenshots for intern work reports
    match /interns/{uid}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid
                   && firestore.exists(/databases/(default)/documents/interns/$(uid))
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Event cover images (admins upload, everyone can see)
    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}