rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true;
    }

    function isParticipant(uid, participants) {
      return participants != null && uid in participants;
    }

    function isTwoStringList(l) {
      return l is list && l.size() == 2 && l[0] is string && l[1] is string;
    }

    // Chats started from a random call are free for a limited window, then need Premium.
    function isChatOpen(thread) {
      return thread.get('source', '') != 'random_call'
        || thread.get('unlocked', false) == true
        || request.time < thread.chatExpiresAt;
    }

    function otherParticipant(participants) {
      return participants[0] == request.auth.uid ? participants[1] : participants[0];
    }


    // Fields only admins / Cloud Functions may set on a user profile.
    function protectedUserKeys() {
      return ['isAdmin', 'banned', 'bannedAt', 'banReason', 'referralEarningsPaid',
              'referralDiscountUsed', 'referralDiscountUsedAt', 'premiumUntil',
              // Set by moderation: hidden from others until reviewed
              'underReview', 'underReviewAt', 'photoHidden'];
    }

    // DateU is 18+. Date of birth is "YYYY-MM-DD"; the 18th birthday must have passed.
    function isAdultDob(dob) {
      let p = dob.split('-');
      return dob is string
        && dob.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(p[0]) + 18, int(p[1]), int(p[2]) > 28 ? 28 : int(p[2])) <= request.time;
    }

    function blockedEitherWay(a, b) {
      return (exists(/databases/$(database)/documents/userBlocks/$(a))
                && b in get(/databases/$(database)/documents/userBlocks/$(a)).data.get('uids', []))
          || (exists(/databases/$(database)/documents/userBlocks/$(b))
                && a in get(/databases/$(database)/documents/userBlocks/$(b)).data.get('uids', []));
    }

    // The recipient's "who can send me requests" and "only my gender can find me" settings
    function friendRequestAllowed(from, to) {
      let recipient = get(/databases/$(database)/documents/users/$(to)).data;
      let sender = get(/databases/$(database)/documents/users/$(from)).data;
      let senderVerified = sender.get('verified', false) == true
                           || sender.get('collegeId', {}).get('verified', false) == true;
      return recipient.get('underReview', false) != true
        && recipient.get('banned', false) != true
        && (recipient.get('requestsFrom', 'everyone') != 'verified' || senderVerified)
        && (recipient.get('friendsAudience', 'all') != 'same' || sender.get('gender', '') == recipient.get('gender', 'x'));
    }

    // Private contact data lives in userPrivate/{uid}; it must not be (re)added to the
    // publicly readable profile. Removing it (migration) is allowed.
    function privateUserKeys() {
      return ['email', 'phoneNumber', 'upiId', 'fcmToken', 'instagramId'];
    }

    // Owners can't mark their own college ID verified or put ID image URLs on the public profile.
    function collegeIdWriteOk() {
      let before = resource == null ? {} : resource.data.get('collegeId', {});
      let after = request.resource.data.get('collegeId', {});
      return (after.get('verified', false) == false || after.get('verified', false) == before.get('verified', false))
        && (after.get('frontUrl', null) == null || after.get('frontUrl', null) == before.get('frontUrl', null))
        && (after.get('backUrl', null) == null || after.get('backUrl', null) == before.get('backUrl', null));
    }

    function signupsPaused() {
      return exists(/databases/$(database)/documents/config/app)
        && get(/databases/$(database)/documents/config/app).data.get('signupsPaused', false) == true;
    }

    // Friends: an accepted request in either direction (checked after the
    // current write, so accepting and creating the chat can be one batch)
    function friendsAccepted(a, b) {
      return (existsAfter(/databases/$(database)/documents/friendRequests/$(a + '_' + b))
                && getAfter(/databases/$(database)/documents/friendRequests/$(a + '_' + b)).data.status == 'accepted')
          || (existsAfter(/databases/$(database)/documents/friendRequests/$(b + '_' + a))
                && getAfter(/databases/$(database)/documents/friendRequests/$(b + '_' + a)).data.status == 'accepted');
    }

    function isStudent(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('userType', 'college') != 'general';
    }

    function isBanned() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true;
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (
        request.auth != null && request.auth.uid == uid
        && !signupsPaused()
        && !request.resource.data.keys().hasAny(protectedUserKeys())
        && !request.resource.data.keys().hasAny(privateUserKeys())
        && collegeIdWriteOk()
        && (!('dob' in request.resource.data) || request.resource.data.dob == null || isAdultDob(request.resource.data.dob))
      );
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserKeys())
        && !request.resource.data.diff(resource.data).addedKeys().hasAny(privateUserKeys())
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(privateUserKeys())
        && collegeIdWriteOk()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dob'])
            || request.resource.data.dob == null
            || isAdultDob(request.resource.data.dob))
      );
      allow delete: if isAdmin();
    }

    // Email, phone, UPI ID, push token and college ID images: owner and admins only.
    match /userPrivate/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow delete: if isAdmin();
    }
    

    // Plans
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Subscriptions
    match /subscriptions/{subId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && (!('utr' in request.resource.data) || request.resource.data.utr.matches('^[0-9]{12}$'));
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Friend requests between students. Id = "<from>_<to>".
    match /friendRequests/{reqId} {
      allow read: if request.auth != null
                  && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
      allow create: if request.auth != null
                    && !isBanned()
                    && isStudent(request.auth.uid)
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.to != request.auth.uid
                    && reqId == request.auth.uid + '_' + request.resource.data.to
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly(['from', 'to', 'status', 'createdAt', 'message'])
                    && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 140))
                    // Not if they already sent you one (accept that instead)
                    && !exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.to + '_' + request.auth.uid))
                    && !blockedEitherWay(request.auth.uid, request.resource.data.to)
                    && friendRequestAllowed(request.auth.uid, request.resource.data.to);
      // Only the recipient answers
      allow update: if request.auth != null
                    && resource.data.to == request.auth.uid
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
                    && request.resource.data.status in ['accepted', 'declined'];
      // Either side can cancel a request or unfriend
      allow delete: if request.auth != null
                    && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid || isAdmin());
    }

    // One doc per UPI transaction ID, so the same payment can't be submitted twice.
    // Create-only: writing an existing UTR is an update, which is denied.
    match /paymentUtrs/{utr} {
      allow create: if request.auth != null
                    && utr.matches('^[0-9]{12}$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'paymentId', 'createdAt']);
      allow read, delete: if isAdmin();
    }

    // Matching rounds and assignments
    match /matchingRounds/{roundId} {
      // The round holds everyone's suggestions, so only admins read it. Members get
      // their own part from the getMyRound function and join with joinMatchingRound.
      allow read, write: if isAdmin();

      match /assignments/{girlUid} {
        allow read: if request.auth != null && (request.auth.uid == girlUid || isAdmin());
        allow write: if isAdmin();
      }
    }

    // Likes
    match /likes/{likeId} {
      allow create: if request.auth != null
                    && (
                      request.resource.data.likingUserUid == request.auth.uid
                      || request.resource.data.likerUid == request.auth.uid
                    )
                    && request.resource.data.likedUserUid is string
                    && request.resource.data.roundId is string;
      allow read: if request.auth != null;
      allow update, delete: if isAdmin()
                            || (request.auth != null && resource.data.likingUserUid == request.auth.uid)
                            || (request.auth != null && resource.data.likerUid == request.auth.uid);
    }

    // Matches (readable by participants, writes via Cloud Functions)
    match /matches/{matchId} {
      allow read: if request.auth != null
                  && ((resource.data.participants != null && request.auth.uid in resource.data.participants) || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Chat threads and messages
    match /threads/{threadId} {
      // Participants (or admin) can read existing threads
      // A missing thread may be read by either person named in its id, so clients can
      // check for it before creating it (instead of overwriting an existing one).
      allow read: if request.auth != null && (
        (resource == null && request.auth.uid in threadId.split('_'))
        || isAdmin()
        || (resource != null && isParticipant(request.auth.uid, resource.data.participants))
      );

      // Create must include two participants incl. the caller, and timestamps
      allow create: if request.auth != null
                    && isTwoStringList(request.resource.data.participants)
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.createdAt != null
                    && request.resource.data.updatedAt != null
                    && !('unlocked' in request.resource.data)
                    // Only the server creates random-call chats; friend chats need an accepted request
                    && (!('source' in request.resource.data) || (request.resource.data.source == 'friend'
                          && friendsAccepted(request.resource.data.participants[0], request.resource.data.participants[1])))
                    && (!('friend' in request.resource.data) || friendsAccepted(request.resource.data.participants[0], request.resource.data.participants[1]));

      // Update allowed for participants as long as participants list is unchanged
      allow update: if isAdmin()
                    || (
                      request.auth != null
                      && isParticipant(request.auth.uid, resource.data.participants)
                      // Random-call chat window fields are server-managed
                      && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['source', 'chatExpiresAt', 'connectedAt', 'randomCallId', 'unlocked', 'unlockedBy', 'unlockedAt'])
                      // Marking a chat as a friends chat needs an accepted friend request
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['friend'])
                          || request.resource.data.friend != true
                          || friendsAccepted(resource.data.participants[0], resource.data.participants[1]))
                      // Relaxed to allow typing/read status updates without strict check on participants immutability for MVP
                      // && request.resource.data.participants == resource.data.participants
                    );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && (isAdmin()
                        || (
                          exists(/databases/$(database)/documents/threads/$(threadId)) &&
                          isParticipant(
                             request.auth.uid,
                             get(/databases/$(database)/documents/threads/$(threadId)).data.participants
                           )
                        ));

        allow create: if request.auth != null
                      && (
                        // If thread exists, checking participants. If not, we assume valid if creating (though ensureThread should run first)
                        // Actually, creating a message SHOULD fail if thread doesn't exist?
                        // But ensureThread handles thread creation.
                        // So let's require thread existence.
                        exists(/databases/$(database)/documents/threads/$(threadId)) &&
                        isParticipant(
                             request.auth.uid,
                             get(/databases/$(database)/documents/threads/$(threadId)).data.participants
                        )
                      )
                      && isChatOpen(get(/databases/$(database)/documents/threads/$(threadId)).data)
                      && !isBanned()
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.createdAt != null;

        allow update: if isAdmin()
                      || (
                        request.auth != null
                        && resource.data.senderUid == request.auth.uid
                        && request.time < resource.data.createdAt + duration.value(30, 'm')
                      )
                      // Either participant can like / unlike a message
                      || (
                        request.auth != null
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                        && isParticipant(
                             request.auth.uid,
                             get(/databases/$(database)/documents/threads/$(threadId)).data.participants
                           )
                      );
        allow delete: if isAdmin()
                      || (
                        request.auth != null
                        && resource.data.senderUid == request.auth.uid
                        && request.time < resource.data.createdAt + duration.value(30, 'm')
                      );
      }
    }

    // Per-user block list for chat gating: userBlocks/{userId}
    // - Self (and admin) can read/write their own block list.
    // - The blocked person can read the doc only if their uid is in the list (to discover they’re blocked).
    // - If the doc does not exist, allow read so onSnapshot/getDoc won’t fail.
    match /userBlocks/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||                                      // owner
        isAdmin() ||                                                        // admin
        // "who blocked me" query (where uids array-contains me)
        (resource != null && request.auth.uid in resource.data.get('uids', [])) ||
        !exists(/databases/$(database)/documents/userBlocks/$(userId)) ||   // non-existent doc is OK to read
        (
          exists(/databases/$(database)/documents/userBlocks/$(userId)) &&  // blocked user can read
          request.auth.uid in (get(/databases/$(database)/documents/userBlocks/$(userId)).data.uids || [])
        )
      );

      // Only the owner (or admin for delete) can modify their list
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Optional: reports created from the chat Report flow
    match /reports/{reportId} {
      // Allow users to create reports about others; admin can read/manage
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.reportedUid is string
                    && request.resource.data.threadId is string
                    && request.resource.data.reason is string
                    && request.resource.data.createdAt != null;
      allow read: if isAdmin() || (request.auth != null && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /notifications/{id} {
      // Admins: full access
      allow read, create, delete: if isAdmin();

      // Everyone: can read group/global notifications (userUid == null)
      allow read: if request.auth != null && resource.data.userUid == null;

      // Only owner and admin can read personal notifications
      allow read: if request.auth != null
        && resource.data.userUid == request.auth.uid;

      // Owners can only mark their own personal notifications as seen
      allow update: if request.auth != null
        && resource.data.userUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt']);
    }

    // Account Deletion Requests
    match /account_delete_requests/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read, update, delete: if isAdmin();
    }

    // Support Queries
    match /support_queries/{queryId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Referrals
    match /referrals/{referralId} {
      // Create: a new user records who referred them, once (doc id = their uid).
      allow create: if request.auth != null
                    && referralId == request.auth.uid
                    && request.resource.data.refereeUid == request.auth.uid
                    && request.resource.data.referrerUid is string
                    && request.resource.data.referrerUid != request.auth.uid
                    && request.resource.data.hasMatched == false
                    && request.resource.data.status == 'pending';
      // Read: Referrer can see who they referred, Referee can see their own record
      allow read: if request.auth != null && (
        resource.data.referrerUid == request.auth.uid || 
        resource.data.refereeUid == request.auth.uid || 
        isAdmin()
      );
      // Update: qualification is set by confirmMatchByGirl (Cloud Function) or an admin.
      allow update: if isAdmin();
    }

    // Referral Claims
    match /referral_claims/{claimId} {
      // Create: Authenticated user can create their own claim
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.amount <= 10000
                    && request.resource.data.upiId is string
                    && request.resource.data.upiId.size() <= 100;
      // Read: Users read own claims, admins read all
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      // Update: Admin approves/rejects
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }


    // Job Applications
    match /job_applications/{appId} {
      // Public submission, limited to the form's fields and sane sizes
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'email', 'phone', 'college', 'linkedin', 'resumeLink', 'whyFit', 'role', 'status', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+$')
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.get('phone', '').size() <= 30
                    && request.resource.data.get('college', '').size() <= 200
                    && request.resource.data.get('linkedin', '').size() <= 300
                    && request.resource.data.get('resumeLink', '').size() <= 500
                    && request.resource.data.get('whyFit', '').size() <= 5000
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ---- Random voice calls ----
    // Queue entries are written by joinRandomCallQueue; the owner may only send
    // heartbeats or leave the queue.
    match /callQueue/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heartbeatAt']);
      allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    match /randomCallStats/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // config/app (maintenance, announcement) is public so the landing page can show it
    match /config/{configId} {
      allow read: if request.auth != null || configId == 'app';
      allow write: if isAdmin();
    }

    // Server-only settings (e.g. TURN credentials): admins manage, users never read
    match /serverConfig/{configId} {
      allow read, write: if isAdmin();
    }

    // Photo moderation (written by Cloud Functions only)
    match /photoReviews/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /photoChecks/{id} {
      allow read, write: if false;
    }

    // Append-only record of admin actions
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Created by joinRandomCallQueue; participants exchange WebRTC signaling and
    // record their own post-call decision.
    match /randomCalls/{callId} {
      // calleeUid check lets the callee listen for incoming (ringing) calls with a query
      allow read: if request.auth != null
                  && (resource.data.calleeUid == request.auth.uid
                      || request.auth.uid in resource.data.participants
                      || isAdmin());
      allow update: if isAdmin() || (
                      request.auth != null
                      && request.auth.uid in resource.data.participants
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['offer', 'answer', 'status', 'startedAt', 'endedAt', 'endedBy', 'endReason', 'decisions', 'media'])
                      && request.resource.data.get('decisions', {}).get(otherParticipant(resource.data.participants), null)
                           == resource.data.get('decisions', {}).get(otherParticipant(resource.data.participants), null)
                      // Connection report ({ ok, relay }): only your own entry
                      && request.resource.data.get('media', {}).get(otherParticipant(resource.data.participants), null)
                           == resource.data.get('media', {}).get(otherParticipant(resource.data.participants), null)
                    );
      allow create, delete: if false;

      match /candidates/{candidateId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/randomCalls/$(callId)).data.participants;
        allow create: if request.auth != null
                      && request.resource.data.from == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/randomCalls/$(callId)).data.participants;
        allow update, delete: if false;
      }
    }

    // Events (fests, find-a-buddy nights, meetups). Admins create them; members register.
    // attendeeCount moves by exactly one, together with the member's own attendee doc.
    function eventDoc(eventId) {
      return /databases/$(database)/documents/events/$(eventId);
    }
    function attendeeDoc(eventId, uid) {
      return /databases/$(database)/documents/events/$(eventId)/attendees/$(uid);
    }

    match /events/{eventId} {
      // Published events are public, so shared event links work for anyone
      allow read: if resource.data.status in ['published', 'cancelled'] || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCount'])
        && (
          (request.resource.data.attendeeCount == resource.data.get('attendeeCount', 0) + 1
            && !exists(attendeeDoc(eventId, request.auth.uid))
            && existsAfter(attendeeDoc(eventId, request.auth.uid))
            && (resource.data.get('capacity', 0) == 0 || request.resource.data.attendeeCount <= resource.data.capacity))
          || (request.resource.data.attendeeCount == resource.data.get('attendeeCount', 0) - 1
            && exists(attendeeDoc(eventId, request.auth.uid))
            && !existsAfter(attendeeDoc(eventId, request.auth.uid)))
        )
      );

      // Who's going: visible to people who are going too (and admins)
      match /attendees/{uid} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid || exists(attendeeDoc(eventId, request.auth.uid)) || isAdmin());
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && !isBanned()
                      && get(eventDoc(eventId)).data.status == 'published'
                      && request.time < get(eventDoc(eventId)).data.endAt
                      && getAfter(eventDoc(eventId)).data.get('attendeeCount', 0) == get(eventDoc(eventId)).data.get('attendeeCount', 0) + 1
                      && request.resource.data.uid == uid
                      && request.resource.data.keys().hasOnly(['uid', 'name', 'photoUrl', 'college', 'gender', 'userType', 'lookingForBuddy', 'note', 'createdAt'])
                      && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 140));
        allow update: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lookingForBuddy', 'note', 'name', 'photoUrl', 'college'])
                      && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 140));
        allow delete: if isAdmin() || (
                        request.auth != null
                        && request.auth.uid == uid
                        && getAfter(eventDoc(eventId)).data.get('attendeeCount', 0) == get(eventDoc(eventId)).data.get('attendeeCount', 0) - 1
                      );
      }
    }

    // Interest groups: anyone signed in can see groups; members post plans ("Anyone up for …?")
    match /groups/{groupId} {
      function isMember() {
        return request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('memberUids', []);
      }
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null
        && !isBanned()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'memberCount'])
        && (
          // join
          (!(request.auth.uid in resource.data.get('memberUids', []))
            && request.resource.data.memberUids.hasAll(resource.data.get('memberUids', []))
            && request.resource.data.memberUids.toSet().difference(resource.data.get('memberUids', []).toSet()) == [request.auth.uid].toSet()
            && request.resource.data.memberCount == resource.data.get('memberCount', 0) + 1)
          // leave
          || ((request.auth.uid in resource.data.get('memberUids', []))
            && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()) == [request.auth.uid].toSet()
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
            && request.resource.data.memberCount == resource.data.get('memberCount', 1) - 1)
        )
      );

      match /posts/{postId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && !isBanned()
                      && isMember()
                      && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('underReview', false) != true
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.keys().hasOnly(['authorUid', 'authorName', 'authorPhoto', 'authorCollege', 'text', 'when', 'inUids', 'inCount', 'createdAt'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
                      && (!('when' in request.resource.data) || (request.resource.data.when is string && request.resource.data.when.size() <= 60))
                      && request.resource.data.inUids == []
                      && request.resource.data.inCount == 0;
        // "I'm in" (or take it back): only your own uid, count kept in step
        allow update: if request.auth != null
                      && !isBanned()
                      && request.auth.uid != resource.data.authorUid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inUids', 'inCount'])
                      && (
                        (!(request.auth.uid in resource.data.inUids)
                          && request.resource.data.inUids.toSet().difference(resource.data.inUids.toSet()) == [request.auth.uid].toSet()
                          && request.resource.data.inUids.size() == resource.data.inUids.size() + 1
                          && request.resource.data.inCount == resource.data.inCount + 1)
                        || ((request.auth.uid in resource.data.inUids)
                          && resource.data.inUids.toSet().difference(request.resource.data.inUids.toSet()) == [request.auth.uid].toSet()
                          && request.resource.data.inUids.size() == resource.data.inUids.size() - 1
                          && request.resource.data.inCount == resource.data.inCount - 1)
                      );
        allow delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.authorUid);
      }
    }

    // "Host an event with DateU" requests from members and fest organisers
    match /eventSuggestions/{id} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'title', 'details', 'when', 'where', 'contact', 'createdAt', 'status'])
                    && request.resource.data.title is string && request.resource.data.title.size() <= 120
                    && request.resource.data.get('details', '').size() <= 1000
                    && request.resource.data.status == 'new';
      allow read, update, delete: if isAdmin();
    }

    // Certificates
    match /certificates/{certId} {
      allow read: if true; // Public verification
      allow write: if isAdmin();
    }

  }
}